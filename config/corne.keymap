#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_es_latin_american.h"

#define BASE_TD     0
#define NAV         1
#define MOUSE       2
#define MEDIA       3
#define NUM         4
#define SYM         5
#define FUN         6

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    /* combos { */
    /*     compatible = "zmk,combos"; */
    /**/
    /*     er_less { */
    /*         bindings = <&kp ES_LT>; */
    /*         key-positions = <2 3>; */
    /*     }; */
    /**/
    /*     rt_greater { */
    /*         bindings = <&kp ES_GT>; */
    /*         key-positions = <3 4>; */
    /*     }; */
    /**/
    /*     yu_plus { */
    /*         bindings = <&kp ES_PLUS>; */
    /*         key-positions = <5 6>; */
    /*     }; */
    /**/
    /*     hj_minus { */
    /*         bindings = <&kp ES_MINUS>; */
    /*         key-positions = <15 16>; */
    /*     }; */
    /**/
    /*     nm_asterisk { */
    /*         bindings = <&kp ES_ASTERISK>; */
    /*         key-positions = <25 26>; */
    /*     }; */
    /**/
    /*     space_enter_base { */
    /*         timeout-ms = <100>; */
    /*         key-positions = <32 33>; */
    /*         layers = <BASE_TD BASE_NORMAL>; */
    /*         bindings = <&base_hold BASE_NORMAL 0>; */
    /*     }; */
    /* }; */

    /* behaviors { */
    /*     td_lshft_caps: td_lshft_caps { */
    /*         compatible = "zmk,behavior-tap-dance"; */
    /*         label = "TD_LSHFT_CAPS"; */
    /*         #binding-cells = <0>; */
    /*         tapping-term-ms = <200>; */
    /*         bindings = <&kp LSHFT>, <&kp CAPS>; */
    /*     }; */
    /**/
    /*     base_hold: base_hold { */
    /*         compatible = "zmk,behavior-hold-tap"; */
    /*         #binding-cells = <2>; */
    /*         flavor = "tap-preferred"; */
    /*         tapping-term-ms = <2000>; */
    /*         bindings = <&tog>, <&none>; */
    /*     }; */
    /* }; */
    behaviors {
      ht: hold_tap {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms= <200>;
        bindings = <&kp>, <&kp>;
        display-name = "hold_tap";
        retro-tap;
      };

      ht_gui: hold_tap_gui {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <180>;
        quick-tap-ms= <200>;
        bindings = <&kp>, <&kp>;
        display-name = "hold_tap_gui";
        retro-tap;
      }

      htl: hold_tap_l {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <150>;
        quick-tap-ms= <200>;
        bindings = <&kp>, <&kp>;
        display-name = "hold_tap_l";
        retro-tap;
      }
    }

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
    &ht_gui LGUI A  &ht LALT S  &ht LCTRL D  &htl LSHFT F  &kp G  &kp H  &htl RSHFT J  &ht RCTRL K  &ht RALT L  &ht_gui RGUI ES_N_TILDE
    &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp ES_COMMA  &kp ES_DOT  &kp ES_MINUS
                   &ht MEDIA ESC  &ht NAV SPACE  &ht MOUSE TAB        &ht SYM RET  &ht NUM DEL  &ht FUN BSPC
            >;
        };

        nav {
          display-name = "Nav";
          bindings = <
    &none  &none  &none  &none  &none  &kp C_AC_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp CAPS
    &none  &none  &none  &none  &none  &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                   &none  &trans   &none         &kp RET  &kp DEL  &kp BSPC
          >;
        };

        mouse {
          display-name = "Mouse";
          bindings = <
    &none  &none  &none  &none  &none  &kp C_AC_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none
    &none  &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
                   &none  &none  &trans          &kp RET  &kp DEL  &kp BSPC
          >;
        };

        media {
          display-name = "Media";
          bindings = <
    &none  &none  &none  &none  &none  &none  &none   &none   &ext_power EP_OFF  &ext_power EP_ON
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &ext_power EP_TOG  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT
    &none  &none  &none  &none  &none  &out OUT_TOG  &mkp MB1  &mkp MB2  &mkp MB3  &mkp MB4
                   &trans  &none  &none          &kp C_STOP  &kp C_PP  &kp C_MUTE
          >;
        };

        num {
          display-name = "Num";
          bindings = <
    &kp ES_LBKT  &kp N7  &kp N8  &kp N9  &kp ES_RBKT  &none  &none  &none  &none  &none
    &kp ES_SEMI  &kp N4  &kp N5  &kp N6  &kp ES_EQUAL  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp ES_TILDE  &kp N1  &kp N2  &kp N3  &kp ES_BSLH  &none  &none  &none  &none  &none
                   &kp ES_LESS_THAN  &kp N0  &kp ES_MINUS        &none  &trans  &none
          >;
        };

        sym {
          display-name = "Sym";
          bindings = <
    &kp ES_LBRC  &kp ES_AMPS  &kp ES_STAR  &kp ES_QUESTION  &kp ES_RBRC  &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &none  &none
    &kp ES_COLON  &kp ES_DLLR  &kp ES_PRCNT  &kp ES_CARET  &kp ES_PLUS  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp ES_TILDE  &kp ES_EXCL  &kp ES_AT  &kp ES_HASH  &kp ES_BSLH  &none  &none  &none  &none  &none
                   &kp ES_LPAR  &kp ES_RPAR  &kp ES_UNDERSCORE        &trans  &none  &none
          >;
        };

        fun {
          display-name = "Fun";
          bindings = <
    &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &none  &none  &none  &none  &none
    &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &none  &none  &none  &none  &none
                   &none  &kp SPACE  &kp TAB        &none  &none  &trans
          >;
        };

    /*     // 1: Base con Shift normal. */
    /*     normal_base_layer { */
    /*         bindings = < */
    /* &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P */
    /* &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp ES_N_TILDE */
    /* &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp ES_MINUS */
    /*           &kp LALT  &mo RAISE  &kp SPACE        &kp RET  &mo LOWER  &kp INSERT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 2: Lower. Shift hereda el comportamiento de la base activa. */
    /*     lower_layer { */
    /*         bindings = < */
    /* &kp ES_AT  &none  &none  &none  &none  &kp N7  &kp N8  &kp N9  &kp ES_PLUS  &kp ES_MINUS */
    /* &none  &none  &none  &kp ES_LPAR  &kp ES_RPAR  &kp N4  &kp N5  &kp N6  &kp N0  &kp UP_ARROW */
    /* &trans  &trans  &trans  &kp ES_QUESTION  &kp ES_EXCL  &kp N1  &kp N2  &kp N3  &kp LEFT_ARROW  &kp DOWN_ARROW */
    /*                           &kp LGUI  &trans  &kp SPACE           &kp RET  &trans  &kp RALT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 3: Raise. */
    /*     raise_layer { */
    /*         bindings = < */
    /* &kp C_PREVIOUS  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ES_PLUS  &kp ES_MINUS */
    /* &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &kp ES_LPAR  &kp ES_RPAR  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp HOME  &kp UP_ARROW */
    /* &trans  &trans  &trans  &kp ES_QUESTION  &kp ES_EXCL  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_ARROW  &kp DOWN_ARROW */
    /*                                             &kp LGUI  &trans  &kp SPACE                &kp RET  &trans  &kp RALT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 4: Extra, activa al mantener Lower + Raise. */
    /*     extra_layer { */
    /*         bindings = < */
    /* &trans  &trans  &trans  &trans  &trans  &kp ES_EQUAL  &kp LS(SQT)  &kp ES_PIPE  &trans  &trans */
    /* &trans  &trans  &trans  &trans  &trans  &kp ES_DQT  &kp ES_SQT  &kp ES_BACKSLASH  &trans  &trans */
    /* &trans  &trans  &trans  &trans  &trans  &ext_power EP_ON  &ext_power EP_OFF  &trans  &trans  &trans */
    /*                            &trans  &trans  &kp SPACE    &kp ENTER  &trans  &kp RIGHT_ALT */
    /*         >; */
    /*     }; */
    };

    /* conditional_layers { */
    /*     compatible = "zmk,conditional-layers"; */
    /**/
    /*     extra_layer { */
    /*         if-layers = <LOWER RAISE>; */
    /*         then-layer = <EXTRA>; */
    /*     }; */
    /* }; */
};
