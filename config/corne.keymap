#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_es_latin_american.h"

#define BASE_TD     0
#define NAV         1
#define MOUSE       2
#define MEDIA       3
#define NUM         4
#define SYM         5
#define FUN         6

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    combos {
        compatible = "zmk,combos";

        er_less {
            bindings = <&kp ES_LT>;
            key-positions = <2 3>;
        };

        rt_greater {
            bindings = <&kp ES_GT>;
            key-positions = <3 4>;
        };

        yu_plus {
            bindings = <&kp ES_PLUS>;
            key-positions = <5 6>;
        };

        hj_minus {
            bindings = <&kp ES_MINUS>;
            key-positions = <15 16>;
        };

        nm_asterisk {
            bindings = <&kp ES_ASTERISK>;
            key-positions = <25 26>;
        };

        space_enter_base {
            timeout-ms = <100>;
            key-positions = <32 33>;
            layers = <BASE_TD BASE_NORMAL>;
            bindings = <&base_hold BASE_NORMAL 0>;
        };
    };

    behaviors {
        td_lshft_caps: td_lshft_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LSHFT_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        base_hold: base_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&tog>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
    &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G  &kp H  &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI ES_N_TILDE
    &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp ES_MINUS
                   &mt &mo MEDIA ESC  &mt &mo NAV SPACE  &mt &mo MOUSE TAB        &mt &mo SYM RET  &mt &mo NUM DEL  &kp BSPC
            >;
        };

        nav {
          display-name = "Nav";
          bindings = <
    &none  &none  &none  &none  &none  &kp C_AC_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &kp LEFT  &kp DOWN  &kp UP  &kp DOWN  &kp CAPS
    &none  &none  &none  &none  &none  &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                   &none  &mo NAV   &none         &kp RET  &kp DEL  &kp BSPC
          >;
        }

        mouse {
          display-name = "Mouse";
          bindings = <
    &none  &none  &none  &none  &none  &kp C_AC_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &kp LEFT  &kp DOWN  &kp UP  &kp DOWN  &none
    &none  &none  &none  &none  &none  &kp MOVE_LEFT  &kp MOVE_DOWN  &kp MOVE_UP  &kp MOVE_RIGHT  &none
                   &none  &none  &mo MOUSE         &kp RET  &kp DEL  &kp BSPC
          >;
        }

        media {
          display-name = "Media";
          bindings = <
    &none  &none  &none  &none  &none  &none  &none   &none   &kp EP_OFF  &kp EP_ON
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &none  &kp EP_TOG  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT
    &none  &none  &none  &none  &none  &kp OUT_TOG  &kp MB1  &kp MB2  &kp MB3  &kp MB4
                   &mo MEDIA  &none  &none          &kp C_STOP  &kp C_PP  &kp C_MUTE
          >;
        }

        num {
          display-name = "Num";
          bindings = <
    &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT  &none  &none  &none  &none  &none
    &kp SEMI  &kp N4  &kp N5  &kp N6  &kp PLUS  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp ES_TILDE  &kp N1  &kp N2  &kp N3  &kp BSLH  &none  &none  &none  &none  &none
                   &kp ES_LESS_THAN  &kp N0  &kp ES_MINUS        &none  &mo NUM  &none
          >;
        }

        sym {
          display-name = "Sym";
          bindings = <
    &kp ES_LBRC  &kp AMPS  &kp STAR  &kp N9  &kp RBRC  &none  &none  &none  &none  &none
    &kp ES_COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp ES_TILDE  &kp EXCL  &kp AT  &kp HASH  &kp BSLH  &none  &none  &none  &none  &none
                   &kp ES_LPAR  &kp ES_RPAR  &kp ES_UNDERSCORE        &mo SYM  &none  &none
          >;
        }

        fun {
          display-name = "Fun";
          bindings = <
    &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &none  &none  &none  &none  &none
    &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
    &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &none  &none  &none  &none  &none
                   &none  &kp SPACE  &kp TAB        &none  &none  &mo FUN
          >;
        }

    /*     // 1: Base con Shift normal. */
    /*     normal_base_layer { */
    /*         bindings = < */
    /* &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P */
    /* &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp ES_N_TILDE */
    /* &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp ES_MINUS */
    /*           &kp LALT  &mo RAISE  &kp SPACE        &kp RET  &mo LOWER  &kp INSERT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 2: Lower. Shift hereda el comportamiento de la base activa. */
    /*     lower_layer { */
    /*         bindings = < */
    /* &kp ES_AT  &none  &none  &none  &none  &kp N7  &kp N8  &kp N9  &kp ES_PLUS  &kp ES_MINUS */
    /* &none  &none  &none  &kp ES_LPAR  &kp ES_RPAR  &kp N4  &kp N5  &kp N6  &kp N0  &kp UP_ARROW */
    /* &trans  &trans  &trans  &kp ES_QUESTION  &kp ES_EXCL  &kp N1  &kp N2  &kp N3  &kp LEFT_ARROW  &kp DOWN_ARROW */
    /*                           &kp LGUI  &trans  &kp SPACE           &kp RET  &trans  &kp RALT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 3: Raise. */
    /*     raise_layer { */
    /*         bindings = < */
    /* &kp C_PREVIOUS  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ES_PLUS  &kp ES_MINUS */
    /* &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &kp ES_LPAR  &kp ES_RPAR  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp HOME  &kp UP_ARROW */
    /* &trans  &trans  &trans  &kp ES_QUESTION  &kp ES_EXCL  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_ARROW  &kp DOWN_ARROW */
    /*                                             &kp LGUI  &trans  &kp SPACE                &kp RET  &trans  &kp RALT */
    /*         >; */
    /*     }; */
    /**/
    /*     // 4: Extra, activa al mantener Lower + Raise. */
    /*     extra_layer { */
    /*         bindings = < */
    /* &trans  &trans  &trans  &trans  &trans  &kp ES_EQUAL  &kp LS(SQT)  &kp ES_PIPE  &trans  &trans */
    /* &trans  &trans  &trans  &trans  &trans  &kp ES_DQT  &kp ES_SQT  &kp ES_BACKSLASH  &trans  &trans */
    /* &trans  &trans  &trans  &trans  &trans  &ext_power EP_ON  &ext_power EP_OFF  &trans  &trans  &trans */
    /*                            &trans  &trans  &kp SPACE    &kp ENTER  &trans  &kp RIGHT_ALT */
    /*         >; */
    /*     }; */
    };

    /* conditional_layers { */
    /*     compatible = "zmk,conditional-layers"; */
    /**/
    /*     extra_layer { */
    /*         if-layers = <LOWER RAISE>; */
    /*         then-layer = <EXTRA>; */
    /*     }; */
    /* }; */
};
